# Copy to `.env.production` (repo root, next to docker-compose.prod.yml) and
# fill in real values. `.env.production` is git-ignored — never commit it.

# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=api.lucasdaniel.dev.br
CORS_ALLOWED_ORIGINS=https://lucasdaniel.dev.br,https://www.lucasdaniel.dev.br
CSRF_TRUSTED_ORIGINS=https://api.lucasdaniel.dev.br

# Only set to True once Caddy is confirmed to be the sole way to reach this
# app (which is what docker-compose.prod.yml sets up: db/backend have no
# published ports). See backend/core/settings.py for what this changes.
BEHIND_REVERSE_PROXY=True

# --- Database (Postgres) ---
POSTGRES_DB=lucasdev
POSTGRES_USER=lucasdev
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Caddy ---
# The real domain on the VM. For local testing, leave this unset (or set to
# `localhost`) so Caddy doesn't try to fetch a real Let's Encrypt cert.
DOMAIN=api.lucasdaniel.dev.br
